# Trakkr backend — environment variables
# Copy to `.env` and fill in real values. Never commit `.env`.

# ─── Required ──────────────────────────────────────────────────────────────
# Mapbox public token (pk.*). Used for backend forward-geocoding and frontend
# map tiles. Public tokens are safe to expose in client-side code; restrict
# allowed referrers in the Mapbox dashboard for production.
MAPBOX_TOKEN=pk.your_public_token_here

# Referer header the backend sends with Mapbox requests. Required when the
# Mapbox token has URL restrictions (which it should, in production). The
# value must EXACTLY match one of the URLs in the token's allowlist.
# Local default: matches the static dev server. Override in production with
# the deployed frontend origin, e.g. "https://www.trakkr.app/".
MAPBOX_REFERER=http://localhost:8765/

# ─── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. Set to your deployed
# frontend URL(s). Use "*" only for quick local testing — never in production.
# Default (when this var is unset): localhost:8765, localhost:5173, 127.0.0.1:8765
CORS_ORIGINS=https://www.trakkr.app,https://trakkr.app

# ─── Optional ──────────────────────────────────────────────────────────────
# Reserved for future authenticated MTA endpoints. Today's MTA feeds we use
# (elevator/escalator XML, GTFS-RT subway alerts) are public and require no key.
MTA_API_KEY=
